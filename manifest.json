{
  "manifest_version": 3,
  "name": "E-Fill",
  "version": "0.1.0",
  "description": "Intelligent form assistant for government and complex online application forms.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "action": {
    "default_title": "E-Fill Application Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "core/canonical-schema.js",
        "core/normalizer.js",
        "content/field-reader.js",
        "content/form-detector.js",
        "content/indicator.js",
        "content/autofill.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
